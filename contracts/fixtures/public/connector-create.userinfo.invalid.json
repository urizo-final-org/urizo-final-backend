{
  "schemaVersion": "1.0",
  "name": "TOUR_CONTENT_API",
  "baseUrl": "https://user@example.invalid/api",
  "endpoint": "/records",
  "method": "GET",
  "authentication": {
    "type": "API_KEY",
    "location": "QUERY",
    "name": "serviceKey",
    "secretRef": "cms-secret://tour-api"
  },
  "requestParameters": [],
